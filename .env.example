# Cloudflare Turnstile. Both values are required before the human check appears.
# Public test keys (the checkbox always passes): https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set to 1 when a reverse proxy puts the visitor address in X-Forwarded-For.
TRUST_PROXY=

# Sliding-window counters. Leave blank to keep the counts in server memory.
# On Vercel, set an Upstash Redis URL. Quotes and AI referrals are stored there.
REDIS_URL=redis://127.0.0.1:6379
